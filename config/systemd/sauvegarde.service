# B2 - Execution de la sauvegarde (lancee par sauvegarde.timer)
# Sortie du script -> journal systemd : journalctl -u sauvegarde.service
[Unit]
Description=Sauvegarde incrementale de /srv et /etc vers /sauvegardes
# Echoue proprement si le second disque n'est pas monte
RequiresMountsFor=/sauvegardes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sauvegarde.sh
Nice=10
IOSchedulingClass=idle
